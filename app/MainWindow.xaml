<Window x:Class="TurboDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TurboDM" Height="640" Width="1120" MinWidth="760" MinHeight="420"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Araç çubuğu -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolButton}" Click="Add_Click" ToolTip="Yeni indirme (Ctrl+N)">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{StaticResource Accent}"/><TextBlock Text="URL Ekle" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Resume_Click" ToolTip="Seçilenleri başlat / devam et">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE768;"/><TextBlock Text="Devam" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Pause_Click" ToolTip="Seçilenleri duraklat">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE769;"/><TextBlock Text="Duraklat" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="ResumeAll_Click">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;"/><TextBlock Text="Hepsini Başlat" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="PauseAll_Click">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;"/><TextBlock Text="Hepsini Durdur" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Border}" Margin="6,4"/>
                    <Button Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTip="Listeden kaldır (Del)">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"/><TextBlock Text="Sil" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="ClearCompleted_Click" ToolTip="Tamamlananları listeden temizle">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;"/><TextBlock Text="Tamamlananları Temizle" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OpenFolder_Click">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/><TextBlock Text="Klasör" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Grid Width="220" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="26,5,6,5"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Style="{StaticResource ToolButton}" Click="Settings_Click">
                        <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/><TextBlock Text="Ayarlar" Margin="0,3,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ffmpeg uyarısı -->
        <Border x:Name="FfmpegBanner" Grid.Row="1" Background="#FFF7E6" BorderBrush="#FCD9A0" BorderThickness="0,0,0,1" Padding="12,7" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="FfmpegButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,4" Content="ffmpeg'i otomatik indir" Click="InstallFfmpeg_Click"/>
                <TextBlock x:Name="FfmpegText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#7A4B00"
                           Text="ffmpeg bulunamadı. YouTube'da 1080p ve üzeri kalite ile HLS yayınlarının MP4'e dönüştürülmesi için gerekli."/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kategoriler -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" Padding="6,8" SelectionChanged="Category_Changed">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F3F4F6"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- İndirme listesi -->
            <DataGrid x:Name="DownloadsGrid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" SelectionMode="Extended" SelectionUnit="FullRow" Background="{StaticResource Panel}"
                      BorderThickness="0" RowHeight="34" CanUserAddRows="False" CanUserResizeRows="False"
                      MouseDoubleClick="Grid_DoubleClick" PreviewKeyDown="Grid_KeyDown"
                      VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Panel}"/>
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Aç" Click="OpenFile_Click"/>
                        <MenuItem Header="Klasörde göster" Click="ShowInFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="Devam et" Click="Resume_Click"/>
                        <MenuItem Header="Duraklat" Click="Pause_Click"/>
                        <MenuItem Header="Baştan indir" Click="Restart_Click"/>
                        <Separator/>
                        <MenuItem Header="Adresi kopyala" Click="CopyUrl_Click"/>
                        <Separator/>
                        <MenuItem Header="Listeden kaldır" Click="Delete_Click"/>
                        <MenuItem Header="Dosyayla birlikte sil" Click="DeleteWithFile_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Dosya adı" Width="*" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border CornerRadius="4" Padding="5,1" Margin="0,0,8,0" Background="#EEF2FF" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Url}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Boyut" Binding="{Binding SizeText, Mode=OneWay}" Width="95"/>
                    <DataGridTemplateColumn Header="İlerleme" Width="170" SortMemberPath="Progress">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Height="18">
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" BorderThickness="0" Background="#E5E7EB">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Foreground" Value="#9CA3AF"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Processing"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#111827"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Hız" Binding="{Binding SpeedText, Mode=OneWay}" Width="95"/>
                    <DataGridTextColumn Header="Kalan" Binding="{Binding EtaText, Mode=OneWay}" Width="80"/>
                    <DataGridTemplateColumn Header="Durum" Width="200" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Eklenme" Binding="{Binding AddedAt, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyHint" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource Muted}" IsHitTestVisible="False" FontSize="14" LineHeight="22">
                Henüz indirme yok.<LineBreak/>Tarayıcıda bir videonun üzerindeki “TurboDM ile indir” butonuna basın<LineBreak/>ya da “URL Ekle” ile bağlantı yapıştırın.
            </TextBlock>
        </Grid>

        <!-- Durum çubuğu -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerText" Foreground="{StaticResource Muted}" Text="Tarayıcı köprüsü"/>
                </StackPanel>
                <TextBlock x:Name="StatusLine" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
